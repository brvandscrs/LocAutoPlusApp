<Window x:Class="LocAutoPlusApp.Views.ClientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client" Height="600" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F0E8">

    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderBrush"     Value="#E8E8E4"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="24" Background="#F4F0E8">
        <StackPanel>

            <TextBlock x:Name="TxtTitre"
                       Text="Nouveau client"
                       FontSize="20" FontWeight="Bold"
                       FontFamily="Georgia"
                       Margin="0,0,0,24"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 0 : Nom / Prénom -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 2 : Email -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 4 : Téléphone / Naissance -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 6 : Adresse -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 8 : Code postal / Ville -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 10 : Mot de passe -->
                </Grid.RowDefinitions>

                <!-- Nom -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Nom *" FontSize="11" Foreground="#999999"
                               FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtNom" Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Prénom -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Prénom *" FontSize="11" Foreground="#999999"
                               FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtPrenom" Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="Adresse e-mail *" FontSize="11" Foreground="#999999"
                               FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtEmail" Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Téléphone -->
                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="Téléphone" FontSize="11" Foreground="#999999"
                               FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtTelephone" Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Date de naissance -->
                <StackPanel Grid.Row="4" Grid.Column="2">
                    <TextBlock Text="Date de naissance" FontSize="11" Foreground="#999999"
                               FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DpNaissance"
                                Height="38" FontFamily="Segoe UI" FontSize="13"
                                BorderBrush="#E8E8E4" Background="White"/>
                </StackPanel>

                <!-- Adresse -->
                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="Adresse" FontSize="11" Foreground="#999999"
                               FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtAdresse" Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Code postal / Ville -->
                <StackPanel Grid.Row="8" Grid.Column="0">
                    <TextBlock Text="Code postal" FontSize="11" Foreground="#999999"
                               FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtCodePostal" Style="{StaticResource InputStyle}"
                             MaxLength="10"/>
                </StackPanel>

                <StackPanel Grid.Row="8" Grid.Column="2">
                    <TextBlock Text="Ville" FontSize="11" Foreground="#999999"
                               FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtVille" Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Mot de passe (création uniquement) -->
                <StackPanel x:Name="PanelPassword"
                            Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="Mot de passe *" FontSize="11" Foreground="#999999"
                               FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtPassword"
                                 Height="38" Padding="10,0"
                                 FontFamily="Segoe UI" FontSize="13"
                                 BorderBrush="#E8E8E4" BorderThickness="1.5"
                                 Background="White"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Message erreur -->
            <TextBlock x:Name="TxtErreur"
                       Foreground="#C0392B" FontSize="12"
                       FontFamily="Segoe UI"
                       Visibility="Collapsed"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"/>

            <!-- Boutons -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Annuler"
                        Style="{StaticResource BtnStyle}"
                        Background="#E8E8E4"
                        Foreground="#555555"
                        Click="BtnAnnuler_Click"/>
                <Button Grid.Column="2"
                        Content="Enregistrer"
                        Style="{StaticResource BtnStyle}"
                        Background="#0F0F0F"
                        Foreground="White"
                        Click="BtnEnregistrer_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
