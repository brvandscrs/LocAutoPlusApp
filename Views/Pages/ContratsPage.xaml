<Page x:Class="LocAutoPlusApp.Views.Pages.ContratsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:LocAutoPlusApp.Views.Pages"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="870"
      Title="ContratsPage"
      Background="#F4F0E8">

    <Page.Resources>
        <Style x:Key="BtnAction" TargetType="Button">
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Barre d'outils ── -->
        <Border Grid.Row="0" Background="White" CornerRadius="12"
                Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filtre statut -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Statut :" FontSize="12"
                               Foreground="#999999" FontFamily="Segoe UI"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CbStatut" Width="140" Height="36"
                              FontFamily="Segoe UI" FontSize="13"
                              SelectionChanged="CbStatut_SelectionChanged">
                        <ComboBoxItem Content="Tous" IsSelected="True"/>
                        <ComboBoxItem Content="en_attente"/>
                        <ComboBoxItem Content="confirmee"/>
                        <ComboBoxItem Content="en_cours"/>
                        <ComboBoxItem Content="terminee"/>
                        <ComboBoxItem Content="annulee"/>
                    </ComboBox>
                </StackPanel>

                <!-- Recherche -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TxtRecherche"
                             Width="260" Height="36"
                             FontFamily="Segoe UI" FontSize="13"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#E8E8E4" BorderThickness="1.5"
                             Background="White"
                             TextChanged="TxtRecherche_TextChanged"/>
                    <TextBlock x:Name="TxtPlaceholder"
                               Text="Rechercher un client ou véhicule..."
                               Foreground="#BBBBBB" FontSize="12"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="-250,0,0,0"
                               IsHitTestVisible="False"/>
                </StackPanel>

                <!-- Titre filtre client -->
                <TextBlock x:Name="TxtFiltreClient"
                           Grid.Column="2"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"
                           FontSize="12" Foreground="#C9A84C"
                           FontFamily="Segoe UI" Margin="12,0"/>

                <!-- Bouton Nouveau contrat -->
                <Button Grid.Column="3"
                        Content="+ Nouveau contrat"
                        Style="{StaticResource BtnAction}"
                        Background="#0F0F0F"
                        Foreground="White"
                        Click="BtnAjouter_Click"/>
            </Grid>
        </Border>

        <!-- ── Contenu principal ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Liste contrats -->
            <Border Grid.Column="0" Background="White"
                    CornerRadius="12" Margin="0,0,12,0">
                <DataGrid x:Name="DgContrats"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAF8"
                          FontFamily="Segoe UI" FontSize="12"
                          ColumnHeaderHeight="40"
                          RowHeight="44"
                          SelectionChanged="DgContrats_SelectionChanged"
                          Cursor="Hand">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"      Value="#F4F0E8"/>
                            <Setter Property="Foreground"      Value="#999999"/>
                            <Setter Property="FontSize"        Value="11"/>
                            <Setter Property="FontWeight"      Value="SemiBold"/>
                            <Setter Property="Padding"         Value="12,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"        Binding="{Binding Id}"        Width="50"/>
                        <DataGridTextColumn Header="CLIENT"   Binding="{Binding Client}"    Width="*"/>
                        <DataGridTextColumn Header="VÉHICULE" Binding="{Binding Vehicule}"  Width="*"/>
                        <DataGridTextColumn Header="DÉBUT"    Binding="{Binding DateDebut}" Width="90"/>
                        <DataGridTextColumn Header="FIN"      Binding="{Binding DateFin}"   Width="90"/>
                        <DataGridTextColumn Header="MONTANT"  Binding="{Binding Montant}"   Width="90"/>
                        <DataGridTextColumn Header="STATUT"   Binding="{Binding Statut}"    Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Détail contrat -->
            <Border Grid.Column="1" Background="White"
                    CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Détail contrat" FontSize="14"
                                   FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Margin="0,0,0,16"/>

                        <!-- Contenu détail -->
                        <StackPanel x:Name="PanelDetail" Visibility="Collapsed">

                            <!-- ID + Statut -->
                            <Grid Margin="0,0,0,16">
                                <TextBlock x:Name="TxtDetailId"
                                           FontSize="20" FontWeight="Bold"
                                           FontFamily="Georgia"/>
                                <Border x:Name="BadgeStatut"
                                        CornerRadius="20" Padding="10,4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDetailStatut"
                                               FontSize="11" FontWeight="SemiBold"
                                               FontFamily="Segoe UI"/>
                                </Border>
                            </Grid>

                            <!-- Infos -->
                            <ItemsControl x:Name="ListDetails">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="#AAAAAA"
                                                       FontSize="11"
                                                       FontFamily="Segoe UI"/>
                                            <TextBlock Text="{Binding Valeur}"
                                                       Grid.Column="1"
                                                       FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       TextWrapping="Wrap"
                                                       FontWeight="{Binding Gras}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Rectangle Height="1" Fill="#F0F0F0" Margin="0,12,0,12"/>

                            <!-- Boutons selon statut -->
                            <Button x:Name="BtnConfirmer"
                                    Content="✅  Confirmer la réservation"
                                    Style="{StaticResource BtnAction}"
                                    Background="#D4EDDA" Foreground="#155724"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Visibility="Collapsed"
                                    Click="BtnConfirmer_Click"/>

                            <Button x:Name="BtnDemarrer"
                                    Content="🚗  Démarrer la location"
                                    Style="{StaticResource BtnAction}"
                                    Background="#CCE5FF" Foreground="#004085"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Visibility="Collapsed"
                                    Click="BtnDemarrer_Click"/>

                            <Button x:Name="BtnCloturer"
                                    Content="🏁  Clôturer la location"
                                    Style="{StaticResource BtnAction}"
                                    Background="#C9A84C" Foreground="#0F0F0F"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Visibility="Collapsed"
                                    Click="BtnCloturer_Click"/>

                            <Button x:Name="BtnAnnuler"
                                    Content="❌  Annuler le contrat"
                                    Style="{StaticResource BtnAction}"
                                    Background="#FEE2E2" Foreground="#C0392B"
                                    HorizontalAlignment="Stretch"
                                    Visibility="Collapsed"
                                    Click="BtnAnnuler_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtSelectionner"
                                   Text="Sélectionnez un contrat pour voir son détail."
                                   Foreground="#CCCCCC" FontSize="12"
                                   FontFamily="Segoe UI" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
