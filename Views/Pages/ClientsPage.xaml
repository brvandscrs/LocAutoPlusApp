<Page x:Class="LocAutoPlusApp.Views.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:LocAutoPlusApp.Views.Pages"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="870"
      Title="ClientsPage"
      Background="#F4F0E8">

    <Page.Resources>
        <Style x:Key="BtnAction" TargetType="Button">
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Barre d'outils ── -->
        <Border Grid.Row="0" Background="White" CornerRadius="12"
                Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Recherche -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox x:Name="TxtRecherche"
                             Width="300" Height="36"
                             FontFamily="Segoe UI" FontSize="13"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#E8E8E4" BorderThickness="1.5"
                             Background="White"
                             TextChanged="TxtRecherche_TextChanged"/>
                    <TextBlock Text="🔍" FontSize="14"
                               VerticalAlignment="Center"
                               Margin="-28,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="TxtPlaceholder"
                               Text="Rechercher un client..."
                               Foreground="#BBBBBB" FontSize="13"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="-268,0,0,0"
                               IsHitTestVisible="False"/>
                </StackPanel>

                <!-- Bouton Ajouter -->
                <Button Grid.Column="1"
                        Content="+ Nouveau client"
                        Style="{StaticResource BtnAction}"
                        Background="#0F0F0F"
                        Foreground="White"
                        Click="BtnAjouter_Click"/>
            </Grid>
        </Border>

        <!-- ── Contenu principal ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Liste clients -->
            <Border Grid.Column="0" Background="White"
                    CornerRadius="12" Margin="0,0,12,0">
                <DataGrid x:Name="DgClients"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAF8"
                          FontFamily="Segoe UI" FontSize="13"
                          ColumnHeaderHeight="40"
                          RowHeight="44"
                          SelectionChanged="DgClients_SelectionChanged"
                          Cursor="Hand">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"       Value="#F4F0E8"/>
                            <Setter Property="Foreground"       Value="#999999"/>
                            <Setter Property="FontSize"         Value="11"/>
                            <Setter Property="FontWeight"       Value="SemiBold"/>
                            <Setter Property="Padding"          Value="16,0"/>
                            <Setter Property="BorderThickness"  Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOM"      Binding="{Binding NomComplet}" Width="*"/>
                        <DataGridTextColumn Header="EMAIL"    Binding="{Binding Email}"      Width="*"/>
                        <DataGridTextColumn Header="TÉL."     Binding="{Binding Telephone}"  Width="120"/>
                        <DataGridTextColumn Header="CLUB"     Binding="{Binding StatutClub}" Width="90"/>
                        <DataGridTextColumn Header="CONTRATS" Binding="{Binding NbContrats}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Fiche client -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Fiche client" FontSize="14"
                               FontWeight="SemiBold" FontFamily="Segoe UI"
                               Margin="0,0,0,16"/>

                    <!-- Contenu fiche (masqué par défaut) -->
                    <StackPanel x:Name="PanelFiche" Visibility="Collapsed">

                        <!-- Avatar initiales -->
                        <Border Background="#0F0F0F" CornerRadius="40"
                                Width="64" Height="64"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="TxtInitiales"
                                       Foreground="#C9A84C"
                                       FontSize="22" FontWeight="Bold"
                                       FontFamily="Georgia"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Nom -->
                        <TextBlock x:Name="TxtFicheNom"
                                   FontSize="16" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <!-- Statut club -->
                        <Border x:Name="BadgeClub"
                                Background="#FFF3CD" CornerRadius="20"
                                Padding="10,4"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <TextBlock x:Name="TxtFicheClub"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#856404"
                                       FontFamily="Segoe UI"/>
                        </Border>

                        <!-- Infos -->
                        <ItemsControl x:Name="ListInfos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   Grid.Column="0"
                                                   Foreground="#AAAAAA"
                                                   FontSize="11"
                                                   FontFamily="Segoe UI"/>
                                        <TextBlock Text="{Binding Valeur}"
                                                   Grid.Column="1"
                                                   FontSize="12"
                                                   FontFamily="Segoe UI"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Séparateur -->
                        <Rectangle Height="1" Fill="#F0F0F0" Margin="0,12,0,12"/>

                        <!-- Boutons actions -->
                        <Button x:Name="BtnVoirContrats"
                                Content="📋  Voir les contrats"
                                Style="{StaticResource BtnAction}"
                                Background="#F4F0E8"
                                Foreground="#0F0F0F"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Click="BtnVoirContrats_Click"/>
                        <Button x:Name="BtnModifierClient"
                                Content="✏️  Modifier"
                                Style="{StaticResource BtnAction}"
                                Background="#0F0F0F"
                                Foreground="White"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Click="BtnModifierClient_Click"/>
                        <Button x:Name="BtnSupprimerClient"
                                Content="🗑️  Supprimer"
                                Style="{StaticResource BtnAction}"
                                Background="#FEE2E2"
                                Foreground="#C0392B"
                                HorizontalAlignment="Stretch"
                                Click="BtnSupprimerClient_Click"/>
                    </StackPanel>

                    <!-- Message sélection -->
                    <TextBlock x:Name="TxtSelectionner"
                               Text="Sélectionnez un client dans la liste pour voir sa fiche."
                               Foreground="#CCCCCC" FontSize="12"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
