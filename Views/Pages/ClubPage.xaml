<Page x:Class="LocAutoPlusApp.Views.Pages.ClubPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:LocAutoPlusApp.Views.Pages"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="870"
      Title="ClubPage"
      Background="#F4F0E8">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>

            <!-- ── Cartes niveaux ── -->
            <TextBlock Text="Niveaux du Club LocAutoPlus"
                       FontSize="15" FontWeight="SemiBold"
                       FontFamily="Segoe UI" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bronze -->
                <Border Grid.Column="0" CornerRadius="12"
                        Margin="0,0,10,0" Padding="20"
                        Background="White">
                    <StackPanel>
                        <TextBlock Text="🥉" FontSize="32" Margin="0,0,0,8"/>
                        <TextBlock Text="Bronze"
                                   FontSize="18" FontWeight="Bold"
                                   FontFamily="Georgia" Foreground="#CD7F32"/>
                        <TextBlock Text="Dès 0 point"
                                   FontSize="12" Foreground="#999999"
                                   FontFamily="Segoe UI" Margin="0,4,0,8"/>
                        <Border Background="#FEF3E2" CornerRadius="8" Padding="10,6">
                            <TextBlock x:Name="TxtBronzeReduction"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#CD7F32" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock x:Name="TxtBronzeNb"
                                   FontSize="12" Foreground="#999999"
                                   FontFamily="Segoe UI" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Silver -->
                <Border Grid.Column="1" CornerRadius="12"
                        Margin="5,0,5,0" Padding="20"
                        Background="White">
                    <StackPanel>
                        <TextBlock Text="🥈" FontSize="32" Margin="0,0,0,8"/>
                        <TextBlock Text="Silver"
                                   FontSize="18" FontWeight="Bold"
                                   FontFamily="Georgia" Foreground="#A8A9AD"/>
                        <TextBlock Text="Dès 500 points"
                                   FontSize="12" Foreground="#999999"
                                   FontFamily="Segoe UI" Margin="0,4,0,8"/>
                        <Border Background="#F5F5F5" CornerRadius="8" Padding="10,6">
                            <TextBlock x:Name="TxtSilverReduction"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#A8A9AD" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock x:Name="TxtSilverNb"
                                   FontSize="12" Foreground="#999999"
                                   FontFamily="Segoe UI" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Gold -->
                <Border Grid.Column="2" CornerRadius="12"
                        Margin="10,0,0,0" Padding="20"
                        Background="#0F0F0F">
                    <StackPanel>
                        <TextBlock Text="🥇" FontSize="32" Margin="0,0,0,8"/>
                        <TextBlock Text="Gold"
                                   FontSize="18" FontWeight="Bold"
                                   FontFamily="Georgia" Foreground="#C9A84C"/>
                        <TextBlock Text="Dès 1500 points"
                                   FontSize="12" Foreground="#555555"
                                   FontFamily="Segoe UI" Margin="0,4,0,8"/>
                        <Border Background="#1A1A1A" CornerRadius="8" Padding="10,6">
                            <TextBlock x:Name="TxtGoldReduction"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#C9A84C" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock x:Name="TxtGoldNb"
                                   FontSize="12" Foreground="#555555"
                                   FontFamily="Segoe UI" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Liste membres ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Tableau membres -->
                <Border Grid.Column="0" Background="White"
                        CornerRadius="12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Membres du Club"
                                   FontSize="15" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   Margin="20,16,20,12"/>
                        <DataGrid x:Name="DgMembres"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFAF8"
                                  FontFamily="Segoe UI" FontSize="12"
                                  ColumnHeaderHeight="40" RowHeight="44"
                                  SelectionChanged="DgMembres_SelectionChanged"
                                  Cursor="Hand">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"      Value="#F4F0E8"/>
                                    <Setter Property="Foreground"      Value="#999999"/>
                                    <Setter Property="FontSize"        Value="11"/>
                                    <Setter Property="FontWeight"      Value="SemiBold"/>
                                    <Setter Property="Padding"         Value="12,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CLIENT"    Binding="{Binding NomComplet}"    Width="*"/>
                                <DataGridTextColumn Header="NIVEAU"    Binding="{Binding Niveau}"        Width="90"/>
                                <DataGridTextColumn Header="POINTS"    Binding="{Binding PointsTotal}"   Width="80"/>
                                <DataGridTextColumn Header="RÉDUCTION" Binding="{Binding ReductionLabel}" Width="90"/>
                                <DataGridTextColumn Header="MEMBRE DEP." Binding="{Binding DateAdhesion}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Détail membre -->
                <Border Grid.Column="1" Background="White"
                        CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Détail membre" FontSize="14"
                                   FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Margin="0,0,0,16"/>

                        <StackPanel x:Name="PanelDetail" Visibility="Collapsed">

                            <!-- Avatar -->
                            <Border Background="#0F0F0F" CornerRadius="40"
                                    Width="64" Height="64"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12">
                                <TextBlock x:Name="TxtInitiales"
                                           Foreground="#C9A84C"
                                           FontSize="22" FontWeight="Bold"
                                           FontFamily="Georgia"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock x:Name="TxtNomMembre"
                                       FontSize="15" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>

                            <Border x:Name="BadgeNiveau"
                                    CornerRadius="20" Padding="12,5"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                                <TextBlock x:Name="TxtNiveauBadge"
                                           FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Segoe UI"/>
                            </Border>

                            <!-- Barre de progression points -->
                            <TextBlock Text="PROGRESSION" FontSize="10"
                                       FontWeight="SemiBold" Foreground="#999999"
                                       FontFamily="Segoe UI" Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtPointsLabel"
                                           FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxtProchainNiveau"
                                           Grid.Column="1"
                                           FontSize="11" Foreground="#999999"
                                           FontFamily="Segoe UI"/>
                            </Grid>

                            <Border Background="#F0F0F0" CornerRadius="4"
                                    Height="8" Margin="0,0,0,16">
                                <Border x:Name="BarreProgression"
                                        Background="#C9A84C"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Width="0"/>
                            </Border>

                            <!-- Infos -->
                            <ItemsControl x:Name="ListInfos">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="#AAAAAA"
                                                       FontSize="11"
                                                       FontFamily="Segoe UI"/>
                                            <TextBlock Text="{Binding Valeur}"
                                                       Grid.Column="1"
                                                       FontSize="12"
                                                       FontFamily="Segoe UI"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Historique points -->
                            <Rectangle Height="1" Fill="#F0F0F0" Margin="0,12,0,12"/>
                            <TextBlock Text="HISTORIQUE DES POINTS" FontSize="10"
                                       FontWeight="SemiBold" Foreground="#999999"
                                       FontFamily="Segoe UI" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ListHistorique">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Motif}"
                                                           FontSize="11"
                                                           FontFamily="Segoe UI"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Date}"
                                                           FontSize="10"
                                                           Foreground="#AAAAAA"
                                                           FontFamily="Segoe UI"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PointsLabel}"
                                                       Grid.Column="1"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#27AE60"
                                                       FontFamily="Segoe UI"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock x:Name="TxtSelectionner"
                                   Text="Sélectionnez un membre pour voir son détail."
                                   Foreground="#CCCCCC" FontSize="12"
                                   FontFamily="Segoe UI" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
