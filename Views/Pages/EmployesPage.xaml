<Page x:Class="LocAutoPlusApp.Views.Pages.EmployesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:LocAutoPlusApp.Views.Pages"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="870"
      Title="EmployesPage"
      Background="#F4F0E8">

    <Page.Resources>
        <Style x:Key="BtnAction" TargetType="Button">
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Barre d'outils ── -->
        <Border Grid.Row="0" Background="White" CornerRadius="12"
                Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox x:Name="TxtRecherche"
                             Width="300" Height="36"
                             FontFamily="Segoe UI" FontSize="13"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#E8E8E4" BorderThickness="1.5"
                             Background="White"
                             TextChanged="TxtRecherche_TextChanged"/>
                    <TextBlock x:Name="TxtPlaceholder"
                               Text="Rechercher un employé..."
                               Foreground="#BBBBBB" FontSize="13"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="-280,0,0,0"
                               IsHitTestVisible="False"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Nouvel employé"
                        Style="{StaticResource BtnAction}"
                        Background="#0F0F0F" Foreground="White"
                        Click="BtnAjouter_Click"/>
            </Grid>
        </Border>

        <!-- ── Contenu principal ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Liste employés -->
            <Border Grid.Column="0" Background="White"
                    CornerRadius="12" Margin="0,0,12,0">
                <DataGrid x:Name="DgEmployes"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAF8"
                          FontFamily="Segoe UI" FontSize="13"
                          ColumnHeaderHeight="40" RowHeight="44"
                          SelectionChanged="DgEmployes_SelectionChanged"
                          Cursor="Hand">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"      Value="#F4F0E8"/>
                            <Setter Property="Foreground"      Value="#999999"/>
                            <Setter Property="FontSize"        Value="11"/>
                            <Setter Property="FontWeight"      Value="SemiBold"/>
                            <Setter Property="Padding"         Value="16,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOM"     Binding="{Binding NomComplet}"  Width="*"/>
                        <DataGridTextColumn Header="EMAIL"   Binding="{Binding Email}"       Width="*"/>
                        <DataGridTextColumn Header="RÔLE"    Binding="{Binding RoleLabel}"   Width="100"/>
                        <DataGridTextColumn Header="STATUT"  Binding="{Binding StatutLabel}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Fiche employé -->
            <Border Grid.Column="1" Background="White"
                    CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Fiche employé" FontSize="14"
                               FontWeight="SemiBold" FontFamily="Segoe UI"
                               Margin="0,0,0,16"/>

                    <StackPanel x:Name="PanelFiche" Visibility="Collapsed">

                        <!-- Avatar -->
                        <Border x:Name="AvatarBorder"
                                CornerRadius="40" Width="64" Height="64"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="TxtInitiales"
                                       Foreground="White"
                                       FontSize="22" FontWeight="Bold"
                                       FontFamily="Georgia"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="TxtFicheNom"
                                   FontSize="16" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <!-- Badge rôle -->
                        <Border x:Name="BadgeRole"
                                CornerRadius="20" Padding="12,5"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                            <TextBlock x:Name="TxtBadgeRole"
                                       FontSize="12" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"/>
                        </Border>

                        <!-- Infos -->
                        <ItemsControl x:Name="ListInfos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="11"
                                                   FontFamily="Segoe UI"/>
                                        <TextBlock Text="{Binding Valeur}"
                                                   Grid.Column="1"
                                                   FontSize="12"
                                                   FontFamily="Segoe UI"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Height="1" Fill="#F0F0F0" Margin="0,12,0,12"/>

                        <!-- Actions -->
                        <Button x:Name="BtnToggleActif"
                                Style="{StaticResource BtnAction}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Click="BtnToggleActif_Click"/>

                        <Button x:Name="BtnModifier"
                                Content="✏️  Modifier"
                                Style="{StaticResource BtnAction}"
                                Background="#0F0F0F" Foreground="White"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Click="BtnModifier_Click"/>

                        <Button x:Name="BtnSupprimer"
                                Content="🗑️  Supprimer"
                                Style="{StaticResource BtnAction}"
                                Background="#FEE2E2" Foreground="#C0392B"
                                HorizontalAlignment="Stretch"
                                Click="BtnSupprimer_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtSelectionner"
                               Text="Sélectionnez un employé pour voir sa fiche."
                               Foreground="#CCCCCC" FontSize="12"
                               FontFamily="Segoe UI" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
