<Window x:Class="LocAutoPlusApp.Views.MainAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocAutoPlus — Gestion" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900"
        Background="#F4F0E8">

    <Window.Resources>
        <!-- Style bouton sidebar -->
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="#AAAAAA"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="FontWeight"        Value="Normal"/>
            <Setter Property="Height"            Value="46"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"           Value="20,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="8,2">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="16,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style bouton sidebar actif -->
        <Style x:Key="SidebarBtnActive" TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
            <Setter Property="Background" Value="#C9A84C"/>
            <Setter Property="Foreground" Value="#0F0F0F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ SIDEBAR ══════════════ -->
        <Border Grid.Column="0" Background="#0F0F0F">
            <DockPanel>

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="0,28,0,24">
                    <TextBlock HorizontalAlignment="Center">
                        <Run Text="LocAuto" FontSize="22" FontWeight="Bold"
                             FontFamily="Georgia" Foreground="#C9A84C"/>
                        <Run Text="Plus" FontSize="22" FontWeight="Bold"
                             FontFamily="Georgia" Foreground="White"/>
                    </TextBlock>
                    <TextBlock Text="Gestion agence"
                               HorizontalAlignment="Center"
                               FontSize="11" Foreground="#555555"
                               FontFamily="Segoe UI" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Profil employé -->
                <Border DockPanel.Dock="Top"
                        Background="#1A1A1A"
                        CornerRadius="10"
                        Margin="12,0,12,20"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtNomEmploye"
                                   Foreground="White"
                                   FontSize="13" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"/>
                        <TextBlock x:Name="TxtRoleEmploye"
                                   Foreground="#C9A84C"
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Séparateur -->
                <TextBlock DockPanel.Dock="Top"
                           Text="NAVIGATION"
                           Foreground="#333333"
                           FontSize="10" FontWeight="Bold"
                           FontFamily="Segoe UI"
                           Margin="20,0,0,8"/>

                <!-- Boutons déconnexion en bas -->
                <Border DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <Button x:Name="BtnDeconnexion"
                            Content="⏻  Déconnexion"
                            Style="{StaticResource SidebarBtn}"
                            Foreground="#E74C3C"
                            Click="BtnDeconnexion_Click"/>
                </Border>

                <!-- Séparateur bas -->
                <Rectangle DockPanel.Dock="Bottom"
                           Height="1" Fill="#1E1E1E"
                           Margin="16,0,16,8"/>

                <!-- Menu navigation -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="BtnDashboard"
                            Content="🏠  Tableau de bord"
                            Style="{StaticResource SidebarBtnActive}"
                            Click="BtnDashboard_Click"/>
                    <Button x:Name="BtnClients"
                            Content="👥  Clients"
                            Style="{StaticResource SidebarBtn}"
                            Click="BtnClients_Click"/>
                    <Button x:Name="BtnContrats"
                            Content="📋  Contrats"
                            Style="{StaticResource SidebarBtn}"
                            Click="BtnContrats_Click"/>
                    <Button x:Name="BtnVehicules"
                            Content="🚗  Véhicules"
                            Style="{StaticResource SidebarBtn}"
                            Click="BtnVehicules_Click"/>
                    <Button x:Name="BtnClub"
                            Content="⭐  Club LocAutoPlus"
                            Style="{StaticResource SidebarBtn}"
                            Click="BtnClub_Click"/>
                    <Button x:Name="BtnEmployes"
                            Content="🔧  Employés"
                            Style="{StaticResource SidebarBtn}"
                            Visibility="Collapsed"
                            Click="BtnEmployes_Click"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════ ZONE CONTENU ══════════════ -->
        <Border Grid.Column="1" Background="#F4F0E8">
            <DockPanel>

                <!-- Barre du haut -->
                <Border DockPanel.Dock="Top"
                        Background="White"
                        BorderBrush="#E8E8E4"
                        BorderThickness="0,0,0,1"
                        Padding="28,0">
                    <Grid Height="56">
                        <TextBlock x:Name="TxtPageTitre"
                                   Text="Tableau de bord"
                                   FontSize="18" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   Foreground="#0F0F0F"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDate"
                                   FontSize="12" Foreground="#999999"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Contenu principal — Frame -->
                <Frame x:Name="MainFrame"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
