<Window x:Class="LocAutoPlusApp.Views.VehiculeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Véhicule" Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F0E8">

    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderBrush"     Value="#E8E8E4"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderBrush"     Value="#E8E8E4"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background"      Value="White"/>
        </Style>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="24">
        <StackPanel>

            <!-- Titre -->
            <TextBlock x:Name="TxtTitre"
                       Text="Nouveau véhicule"
                       FontSize="20" FontWeight="Bold"
                       FontFamily="Georgia"
                       Margin="0,0,0,24"/>

            <!-- Formulaire -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Immatriculation -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Immatriculation *" FontSize="11"
                               Foreground="#999999" FontFamily="Segoe UI"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtImmat" Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Année -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Année *" FontSize="11"
                               Foreground="#999999" FontFamily="Segoe UI"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtAnnee" Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Marque -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Marque *" FontSize="11"
                               Foreground="#999999" FontFamily="Segoe UI"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtMarque" Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Modèle -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Modèle *" FontSize="11"
                               Foreground="#999999" FontFamily="Segoe UI"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtModele" Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Catégorie -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="Catégorie *" FontSize="11"
                               Foreground="#999999" FontFamily="Segoe UI"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbCategorie"
                              Style="{StaticResource ComboStyle}"
                              DisplayMemberPath="Nom"
                              SelectedValuePath="Id"/>
                </StackPanel>

                <!-- Km actuel -->
                <StackPanel Grid.Row="6" Grid.Column="0">
                    <TextBlock Text="Km actuel" FontSize="11"
                               Foreground="#999999" FontFamily="Segoe UI"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtKm" Style="{StaticResource InputStyle}"
                             Text="0"/>
                </StackPanel>

                <!-- Statut -->
                <StackPanel Grid.Row="6" Grid.Column="2">
                    <TextBlock Text="Statut" FontSize="11"
                               Foreground="#999999" FontFamily="Segoe UI"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbStatut" Style="{StaticResource ComboStyle}">
                        <ComboBoxItem Content="disponible"   IsSelected="True"/>
                        <ComboBoxItem Content="maintenance"/>
                        <ComboBoxItem Content="hors_service"/>
                    </ComboBox>
                </StackPanel>

                <!-- Photo URL -->
                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="URL photo (optionnel)" FontSize="11"
                               Foreground="#999999" FontFamily="Segoe UI"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtPhoto" Style="{StaticResource InputStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Erreur -->
            <TextBlock x:Name="TxtErreur"
                       Foreground="#C0392B" FontSize="12"
                       FontFamily="Segoe UI"
                       Visibility="Collapsed"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"/>

            <!-- Boutons -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Annuler"
                        Style="{StaticResource BtnStyle}"
                        Background="#E8E8E4" Foreground="#555555"
                        Click="BtnAnnuler_Click"/>
                <Button Grid.Column="2"
                        Content="Enregistrer"
                        Style="{StaticResource BtnStyle}"
                        Background="#0F0F0F" Foreground="White"
                        Click="BtnEnregistrer_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
